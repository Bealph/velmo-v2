# Modele de configuration locale. Copier en .env et renseigner.
#
# .env est ignore par Git : AUCUNE valeur reelle ne doit figurer dans ce fichier-ci.
# Il ne documente que des NOMS de parametres.
#
# En ligne (Azure App Service), ces memes noms sont saisis dans les « parametres
# d'application » : le code les lit avec os.getenv, sans un mot de code different.
# Voir le dossier de deploiement, 02-secrets-et-config.md.

# --------------------------------------------------------------------------- #
# Service d'IA — endpoint OpenAI-compatible (finit par /openai/v1)
# --------------------------------------------------------------------------- #
# L'endpoint sert aussi d'INTERRUPTEUR : absent, l'agent bascule sur son repli
# hors-ligne deterministe (EchoLLM). Pratique pour developper sans consommer de credit.
AZURE_AI_INFERENCE_ENDPOINT=
AZURE_AI_INFERENCE_API_KEY=

# Nom du DEPLOIEMENT du modele, pas le nom du modele du catalogue. A renseigner
# explicitement : le defaut code en dur (llm.py) ne correspond a aucun deploiement reel.
AZURE_AI_INFERENCE_MODEL=

# --------------------------------------------------------------------------- #
# LLM-juge (2e ligne des garde-fous) — DESACTIVE par defaut
# --------------------------------------------------------------------------- #
# L'interrupteur est necessaire, pas decoratif : sans lui, le juge s'activait des qu'une
# cle etait presente, donc toujours en production. Valeurs acceptees : 1, true, yes, oui.
# Laisser vide reproduit la configuration validee par la suite de tests.
VELMO_MODERATOR=

# Ressource dediee pour le juge. Vides = il retombe sur la ressource principale
# ci-dessus. Sans objet tant que VELMO_MODERATOR n'est pas active.
AZURE_JUDGE_ENDPOINT=
AZURE_JUDGE_API_KEY=
AZURE_JUDGE_MODEL=

# --------------------------------------------------------------------------- #
# Bases de donnees
# --------------------------------------------------------------------------- #
# Base metier (catalogue, clients, commandes). ATTENTION : si cette variable est
# absente, le code retombe SILENCIEUSEMENT sur une base localhost, sans erreur.
DB_URL=postgresql+psycopg://app:app@localhost:5432/velmo

# Memoire long terme. Deux modes, exclusifs :
#   - VELMO_MEMORY_DB_URL : une base externe (le mode EN LIGNE, exigence R2). Sur une
#     base managee, ne pas oublier ?sslmode=require.
#   - VELMO_MEMORY_DB     : un chemin de fichier SQLite (le mode local et les tests).
# L'URL l'emporte sur le chemin. Un chemin passe EXPLICITEMENT dans le code l'emporte
# sur les deux : c'est ce qui isole chaque cas d'evaluation de la base de production.
VELMO_MEMORY_DB_URL=
VELMO_MEMORY_DB=

# --------------------------------------------------------------------------- #
# FAQ — recherche semantique optionnelle
# --------------------------------------------------------------------------- #
# CHROMA_URL est un INTERRUPTEUR : absente, la FAQ bascule sur la recherche lexicale
# locale (LocalKB), sans aucune dependance supplementaire. C'est le mode retenu en ligne.
CHROMA_URL=http://localhost:8001
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --------------------------------------------------------------------------- #
# Seuils et affichage
# --------------------------------------------------------------------------- #
# Plafond de remboursement avant escalade vers un humain, en euros. Vide = 50.
# Une valeur illisible est ignoree plutot que fatale : une faute de frappe dans un
# parametre d'application ne doit pas empecher l'agent de demarrer.
VELMO_REFUND_CAP=

# Panneau « coulisses » de l'interface (route, verdicts, faits memorises, latence).
# MASQUE par defaut : le brief demande qu'aucune donnee de configuration ne soit exposee
# dans les pages. A activer le temps d'une demonstration. Valeurs : 1, true, yes, oui.
VELMO_DEBUG_PANEL=

# --------------------------------------------------------------------------- #
# Observabilite (optionnelle, service tiers)
# --------------------------------------------------------------------------- #
# LANGFUSE_PUBLIC_KEY est un INTERRUPTEUR : absente, toute l'observabilite est un no-op.
# LANGFUSE_SECRET_KEY n'apparait nulle part dans le code : c'est le SDK qui la lit dans
# l'environnement. Elle figure ici precisement parce qu'un inventaire fonde sur une
# recherche de os.getenv l'aurait manquee.
# Non renseignees en ligne : hors perimetre du brief de deploiement, qui demande le
# Log stream de l'hebergeur pour le suivi.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --------------------------------------------------------------------------- #
# Retire de ce fichier
# --------------------------------------------------------------------------- #
# EVAL_MIN_SCORE : declaree ici jusqu'a present, mais JAMAIS lue par le code. La porte
#   qualite recoit son seuil en argument de ligne de commande (voir le workflow CI :
#   `python -m velmo.mlops.score ... --min-global 90`). La garder laissait croire qu'on
#   pouvait regler le seuil par l'environnement.
# AGENT_LANGUAGE : presente dans certains .env locaux, jamais lue non plus.
