# Azure AI — endpoint OpenAI-compatible (finit par /openai/v1). On choisit le modele
# via le nom de deploiement (parametre `model`).
AZURE_AI_INFERENCE_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_AI_INFERENCE_API_KEY=your-azure-ai-inference-key-here
# LLM principal (reponses de l'agent).
AZURE_AI_INFERENCE_MODEL=grok-4.3
# LLM-juge / moderateur (2e ligne des garde-fous) : rapide + pas cher.
# Meme ressource que le principal : laisse ENDPOINT et KEY vides (repris du principal).
# Ressource dediee : renseigne ENDPOINT (finissant par /openai/v1) + KEY.
AZURE_JUDGE_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_JUDGE_API_KEY=your-azure-ai-inference-key-here
AZURE_JUDGE_MODEL=gpt-5.4-mini

# Base relationnelle (état conversationnel et préférences)
DB_URL=postgresql+psycopg://app:app@localhost:5432/velmo

# Base vectorielle (mémoire long terme épisodique)
CHROMA_URL=http://localhost:8001
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Seuil de note bloquant en CI
EVAL_MIN_SCORE=0.8




